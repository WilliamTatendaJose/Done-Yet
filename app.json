{
  "expo": {
    "name": "Done Yet?",
    "slug": "done-yet",
    "scheme": "doneyet",
    "description": "A local-first accountability app that turns intentions into small, finishable steps.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-brand.png",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.doneyet.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101410",
        "foregroundImage": "./assets/android-icon-foreground-brand.png",
        "monochromeImage": "./assets/android-icon-foreground-brand.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.doneyet.app",
      "allowBackup": false
    },
    "plugins": [
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground-brand.png",
          "color": "#D4F887",
          "defaultChannel": "accountability"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Done Yet? adds your task deadlines to your calendar so they sit alongside the rest of your day."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NextTask",
              "label": "Done Yet? — Next task",
              "description": "Your next task and how many are open",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-quick-actions"
    ]
  }
}
