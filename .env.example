# Optional cloud sync. Only the public Supabase URL and anon key belong here.
# Never put a service-role key in an Expo build.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Supabase's newer name for the same client-safe key (use either one).
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
